//| mill-version: 1.1.6

package build
import mill.*, scalalib.*, publish.*

val jettyVersion = "11.0.12"

object vial extends ScalaModule, SonatypeCentralPublishModule {
  def scalaVersion = "3.9.0"
  def publishVersion = "0.13.1"
  def scalacOptions = Seq("-deprecation", "-feature", "-Werror", "-language:implicitConversions", "-Wunused:imports")
  def mvnDeps = Seq(
    mvn"org.eclipse.jetty:jetty-server:$jettyVersion",
    mvn"org.eclipse.jetty:jetty-unixdomain-server:$jettyVersion",
    mvn"com.lihaoyi::upickle:4.3.2"
  )

  def pomSettings = PomSettings(
    description = "Tiny web framework for Scala inspired by bottle and flask.",
    organization = "net.ivoah",
    url = "https://github.com/ivoah/vial",
    licenses = Seq(License.MIT),
    versionControl = VersionControl.github("ivoah", "vial"),
    developers = Seq(Developer("ivoah", "Noah Rosamilia", "ivoah.net"))
  )
}

object example extends ScalaModule {
  def scalaVersion = "3.9.0"
  def moduleDeps = Seq(vial)
  def mvnDeps = Seq(
    mvn"com.lihaoyi::scalatags:0.13.1"
  )
}
